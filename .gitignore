cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*

# SQLite database
*.db
*.sqlite
*.sqlite3

# Pytest
.pytest_cache/

# Coverage
.coverage
htmlcov/
.coverage.*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
EOF